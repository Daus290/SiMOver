#--------------------------------------------------------------------
# Contoh variabel integrasi AI SiMover (Prompt 53). Tanpa nilai rahasia.
# Salin kunci yang dibutuhkan ke .env lalu isi nilainya. Jangan commit .env.
#--------------------------------------------------------------------

# Token pengirim tepercaya keluaran CORE RIZKIYA (data_origin = rizkiya_core).
# Kosong = pengirim core belum aktif; endpoint menolak kiriman core.
# Isi dengan string acak panjang, misalnya 64 karakter hex.
AI_CORE_INGEST_TOKEN =

# Token worker uji lama buatan Antigravity (data_origin = antigravity_worker_p52).
# Dibaca scripts/ai_worker.ps1 dan diteruskan ke proses worker. BUKAN core Rizkiya.
AI_INGEST_TOKEN =

# AI_TEST_INGEST_TOKEN hanya untuk PHPUnit (phpunit.ai.xml), tidak berlaku di luar ENVIRONMENT=testing.

#--------------------------------------------------------------------
# Staging Vercel (Prompt 63). Isi di Vercel > Settings > Environment
# Variables, BUKAN di file ini. Nama memakai garis bawah karena CodeIgniter
# membaca bentuk app_baseURL sama dengan app.baseURL. Lihat docs/PERSIAPAN_VERCEL.md.
#--------------------------------------------------------------------

# CI_ENVIRONMENT = production

# Opsional. Kosong = memakai alamat HTTPS deployment dari Vercel (VERCEL_BRANCH_URL / VERCEL_URL).
# app_baseURL =

# Database staging terpisah (MySQL/MariaDB yang bisa dijangkau dari internet).
# database_default_hostname =
# database_default_port = 3306
# database_default_database =
# database_default_username =
# database_default_password =

# true bila penyedia database mewajibkan TLS. DB_SSL_CA opsional (path CA bundle).
# DB_SSL = true
# DB_SSL_CA =

# AI_CORE_INGEST_TOKEN staging harus BERBEDA dari token lokal. Isi hanya setelah uji AI disepakati.
