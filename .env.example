#--------------------------------------------------------------------
# Contoh variabel integrasi AI SiMover (Prompt 53). Tanpa nilai rahasia.
# Salin kunci yang dibutuhkan ke .env lalu isi nilainya. Jangan commit .env.
#--------------------------------------------------------------------

# Token pengirim tepercaya keluaran CORE RIZKIYA (data_origin = rizkiya_core).
# Kosong = pengirim core belum aktif; endpoint menolak kiriman core.
# Isi dengan string acak panjang, misalnya 64 karakter hex.
AI_CORE_INGEST_TOKEN =

# Token worker uji lama buatan Antigravity (data_origin = antigravity_worker_p52).
# Dibaca scripts/ai_worker.ps1 dan diteruskan ke proses worker. BUKAN core Rizkiya.
AI_INGEST_TOKEN =

# AI_TEST_INGEST_TOKEN hanya untuk PHPUnit (phpunit.ai.xml), tidak berlaku di luar ENVIRONMENT=testing.
